-- =============================================================================
-- File        : queries/receivables/tenant_ledger.sql
-- Description : Full transaction ledger for a single tenant across all active
--               or historical leases. Produces a running balance suitable for
--               resident statements and audit review.
-- Updated     : 2026-09
-- Parameters  : @TenantCode  VARCHAR(30)  — unique tenant identifier
--               @StartDate   DATE         — ledger start date
--               @EndDate     DATE         — ledger end date
-- =============================================================================

DECLARE @TenantCode VARCHAR(30) = @TenantCode;
DECLARE @StartDate  DATE        = @StartDate;
DECLARE @EndDate    DATE        = ISNULL(@EndDate, CAST(GETDATE() AS DATE));

WITH transactions AS (
    -- Charges (positive — amounts owed)
    SELECT
        c.charge_date                        AS txn_date,
        'Charge'                             AS txn_type,
        c.charge_type                        AS txn_subtype,
        c.description,
        c.charge_amount                      AS debit_amount,
        0.00                                 AS credit_amount,
        c.posted_period,
        l.lease_id,
        u.unit_number,
        p.property_code
    FROM charge   c
    JOIN lease    l ON l.lease_id    = c.lease_id
    JOIN unit     u ON u.unit_id     = l.unit_id
    JOIN property p ON p.property_id = u.property_id
    JOIN tenant   t ON t.tenant_id   = l.tenant_id
    WHERE t.tenant_code = @TenantCode
      AND c.is_voided   = 0
      AND c.charge_date BETWEEN @StartDate AND @EndDate

    UNION ALL

    -- Payments (negative — amounts received)
    SELECT
        pay.payment_date                     AS txn_date,
        'Payment'                            AS txn_type,
        pay.payment_method                   AS txn_subtype,
        CONCAT('Ref: ', pay.reference_number) AS description,
        0.00                                 AS debit_amount,
        pay.amount                           AS credit_amount,
        pay.posted_period,
        l.lease_id,
        u.unit_number,
        p.property_code
    FROM payment  pay
    JOIN lease    l ON l.lease_id    = pay.lease_id
    JOIN unit     u ON u.unit_id     = l.unit_id
    JOIN property p ON p.property_id = u.property_id
    JOIN tenant   t ON t.tenant_id   = l.tenant_id
    WHERE t.tenant_code = @TenantCode
      AND pay.is_voided = 0
      AND pay.payment_date BETWEEN @StartDate AND @EndDate
)
SELECT
    t.tenant_code,
    t.tenant_name,
    txn.property_code,
    txn.unit_number,
    txn.txn_date,
    txn.posted_period,
    txn.txn_type,
    txn.txn_subtype,
    txn.description,
    txn.debit_amount,
    txn.credit_amount,
    -- Running balance (cumulative debit minus cumulative credit)
    SUM(txn.debit_amount - txn.credit_amount)
        OVER (PARTITION BY txn.lease_id
              ORDER BY txn.txn_date, txn.txn_type
              ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_balance
FROM transactions txn
JOIN tenant       t ON t.tenant_code = @TenantCode
ORDER BY
    txn.txn_date,
    txn.txn_type;
